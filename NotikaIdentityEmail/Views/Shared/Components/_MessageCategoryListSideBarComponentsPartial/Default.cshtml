@model List<Category>
<div class="inbox-status">
    <ul class="inbox-st-nav">
        @foreach (var item in Model)
        {
            <li><a asp-action="GetMessageListByCategory" asp-route-categoryId="@item.CategoryId" asp-controller="Message"><i class="@item.CategoryIconUrl"></i> @item.CategoryName</a></li>
        }       
    </ul>
</div>