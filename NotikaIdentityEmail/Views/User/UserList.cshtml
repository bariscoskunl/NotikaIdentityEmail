@model List<AppUser>
@{
    ViewData["Title"] = "UserList";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    int count = 0;
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Kullanıcı Listesi</h2>
                    </div>
                    <div class="row">
                        <table class="table table-bordered table-hover ">
                            <tr>
                                <th>#</th>
                                <th>Ad Soyad</th>
                                <th>Kullanıcı Adı</th>
                                <th>Kullanıcı Email</th>
                                <th>Kullanıcı Durumu</th>
                                <th>Islem</th>
                            </tr>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name @item.Surname</td>
                                        <td>@item.UserName</td>
                                        <td>@item.Email</td>
                                        <td>@item.IsActive</td>
                                        <td>@if (item.IsActive)
                                            {
                                                <a class="btn btn-warning" asp-controller="User" asp-action="DeActivateUser" asp-route-userId="@item.Id">Pasif et</a>
                                            }
                                            else
                                            {
                                                <a class="btn btn-success" asp-controller="User" asp-action="ActivateUser" asp-route-userId="@item.Id">Aktif et</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
