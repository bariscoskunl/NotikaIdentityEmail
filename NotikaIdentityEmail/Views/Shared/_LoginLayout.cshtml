		============================================ -->
    <script src="/notika-master/notika/green-horizotal/js/vendor/modernizr-2.8.3.min.js"></script>
    
    <style>
        .validation-summary-errors ul {
            list-style-type: none;
            padding: 0;
            color: #ff4a4a;
            margin-bottom: 15px;
            text-align: left;
        }
        .field-validation-error {
            color: #ff4a4a;
            font-size: 12px;
            text-align: left;
            display: block;
            margin-top: 5px;
        }

        .nk-navigation a {
            display: inline-block;
        }
        .nk-navigation a[href*="UserLogin"]:hover {
            width: 95px;
        }
        .nk-navigation a[href*="CreateUser"]:hover {
            width: 95px;
        }
        .nk-navigation a[href*="ForgetPassword"]:hover {
            width: 155px;
        }
        .nk-navigation a[href*="Index"]:hover {
            width: 115px;
        }
        .nk-navigation a span {
            margin-left: 5px;
        }
        .nk-block {
            padding-top: 30px;
        }
        .login-content {
            background-image: url('/notika-master/notika/green-horizotal/img/bg.jpg');
            background-size: cover;
            background-position: center;
        }
        .google-btn {
            background-color: #dd4b39;
            color: white;
            width: 100%;
            margin-top: 15px;
            padding: 10px;
            border-radius: 2px;
            text-align: center;
            display: block;
            transition: all 0.3s;
        }
        .google-btn:hover {
            background-color: #c23321;
            color: white;
            text-decoration: none;
        }
        .google-btn i {
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <!--[if lt IE 8]>
