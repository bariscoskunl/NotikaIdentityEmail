@model SimpleUserViewModel
@{
    ViewData["Title"] = "Generate";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Token Üret</h2>
                        <p>Parametreleri doldurup token üretme işlemini yapınız.</p>
                    </div>
                    <form method="post">
                        <div class="row">
                            @* Ad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
                                    </div>
                                </div>
                            </div>

                            @* Soyad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
                                    </div>
                                </div>
                            </div>

                            @* Şehir *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-map"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="City" class="form-control" placeholder="Şehriniz">
                                    </div>
                                </div>
                            </div>

                            @* ImageUrl *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-picture"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adı">
                                    </div>
                                </div>
                            </div>
                                                 

                            <div class="col-lg-12">
                                <div style="margin-top: 20px;">
                                    <button type="submit" class="btn btn-success success-icon-notika">
                                        <i class="notika-icon notika-checked"></i>Token Üret
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model?.Token))
                                {
                                    <div class="alert alert-info" role="alert">
                                    <strong>Üretilen Token:</strong> 
                                    <textarea class="form-control" rows="3" readonly>@Model.Token</textarea>
                                    </div>
                                }
                            </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
