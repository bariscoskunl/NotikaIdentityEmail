@model ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Şifre Sıfırlama";
}

<!-- Reset Password -->
<div class="nk-block toggled" id="l-forget-password">
    <div class="nk-form">
        <h3 style="margin-bottom: 25px; color: #333;">Yeni Şifre Belirleme</h3>
        
        @if (ViewData["Message"] != null)
        {
            <div class="alert alert-success" style="margin-bottom: 20px;">
                @ViewData["Message"]
                <br /><br />
                <a asp-controller="Login" asp-action="UserLogin" class="btn btn-success" style="color: white; text-decoration: none;">Giriş Yap</a>
            </div>
        }
        else
        {
            <p class="text-left" style="margin-bottom: 20px;">Lütfen yeni şifrenizi belirleyiniz.</p>

            <form method="post" asp-action="ResetPassword" asp-controller="PasswordChange">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                
                <div class="input-group">
                    <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-edit"></i></span>
                    <div class="nk-int-st">
                        <input type="password" asp-for="Password" class="form-control" placeholder="Yeni Şifre" required>
                    </div>
                </div>

                <div class="input-group mg-t-15">
                    <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-edit"></i></span>
                    <div class="nk-int-st">
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Şifre (Tekrar)" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-login btn-success btn-float"><i class="notika-icon notika-right-arrow"></i></button>
            </form>
        }
    </div>

    @if (ViewData["Message"] == null)
    {
        <div class="nk-navigation nk-lg-ic rg-ic-stl">
            <a asp-controller="Login" asp-action="UserLogin"><i class="notika-icon notika-right-arrow"></i> <span>Giriş Yap</span></a>
            <a asp-controller="Register" asp-action="CreateUser"><i class="notika-icon notika-plus-symbol"></i> <span>Kayıt Ol</span></a>
            <a asp-controller="Home" asp-action="Index"><i class="notika-icon notika-house"></i> <span>Ana Sayfa</span></a>
        </div>
    }
</div>
