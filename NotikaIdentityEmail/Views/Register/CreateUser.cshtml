@model RegisterUserViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Kayıt Ol";
}

<!-- Register -->
<div class="nk-block toggled" id="l-register">
    <div class="nk-form">
        <h3 style="margin-bottom: 25px; color: #333;">Yeni Kullanıcı Kaydı</h3>

        <form asp-action="CreateUser" asp-controller="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            
            <div class="input-group">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-support"></i></span>
                <div class="nk-int-st">
                    <input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
                </div>
            </div>
            <span asp-validation-for="Name" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-support"></i></span>
                <div class="nk-int-st">
                    <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
                </div>
            </div>
            <span asp-validation-for="Surname" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-mail"></i></span>
                <div class="nk-int-st">
                    <input type="email" asp-for="Email" class="form-control" placeholder="E-posta Adresi">
                </div>
            </div>
            <span asp-validation-for="Email" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-promos"></i></span>
                <div class="nk-int-st">
                    <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adı">
                </div>
            </div>
            <span asp-validation-for="UserName" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-edit"></i></span>
                <div class="nk-int-st">
                    <input type="password" asp-for="Password" class="form-control" placeholder="Şifre">
                </div>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-edit"></i></span>
                <div class="nk-int-st">
                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifreyi Onayla">
                </div>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>

            <button type="submit" class="btn btn-login btn-success btn-float"><i class="notika-icon notika-right-arrow"></i></button>

            <button type="submit" formnovalidate asp-action="ExternalLogin" asp-controller="Login" name="provider" value="Google" class="google-btn">
                <i class="fa fa-google"></i> Google ile Kayıt Ol
            </button>
        </form>
    </div>

    <div class="nk-navigation rg-ic-stl">
        <a asp-controller="Login" asp-action="UserLogin"><i class="notika-icon notika-right-arrow"></i> <span>Giriş Yap</span></a>
        <a asp-controller="PasswordChange" asp-action="ForgetPassword"><i>?</i> <span>Şifremi Unuttum</span></a>
        <a asp-controller="Home" asp-action="Index"><i class="notika-icon notika-house"></i> <span>Ana Sayfa</span></a>
    </div>
</div>
