@model Category
@{
    ViewData["Title"] = "UpdateCategory";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Kategori Güncelle</h2>
                    </div>                   
                    <div class="row">
                        
                        <form method="post" asp-action="UpdateCategory" asp-controller="Category">
                            <input type="hidden" asp-for="CategoryId" />
                            <div class="form-group">
                                <label for="CategoryName">Kategori Adı</label>
                                <input type="text" class="form-control" asp-for="CategoryName" required>
                            </div>
                            <div class="form-group">
                                <label for="CategoryIconUrl">Kategori Ikon Url</label>
                                <input type="text" class="form-control" asp-for="CategoryIconUrl" required>
                            </div>
                            <button type="submit" class="btn btn-success">Kategori Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
