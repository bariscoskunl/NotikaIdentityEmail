<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
    <div class="inbox-left-sd">
        <div class="compose-ml">
            <a class="btn" asp-action="ComposeMessage" asp-fragment="Message">Yeni Mesaj Olustur</a>
        </div>
        <div class="inbox-status">
            <ul class="inbox-st-nav inbox-ft">
                <li><a asp-action="Inbox" asp-controller="Message"><i class="notika-icon notika-mail"></i> Gelen Kutusu<span class="pull-right">@ViewBag.recieveMessageCount</span></a></li>
                <li><a asp-action="Sendbox" asp-controller="Message"><i class="notika-icon notika-sent"></i> Gonderilmis Postalar<span class="pull-right">@ViewBag.SendMessageCount</span></a></li>
                <li><a asp-action="Draft" asp-controller="Message"><i class="notika-icon notika-draft"></i> Taslaklar<span class="pull-right">0</span></a></li>
                <li><a asp-action="Trash" asp-controller="Message"><i class="notika-icon notika-trash"></i> Cop Kutusu<span class="pull-right">0</span></a></li>
            </ul>
        </div>
        <hr>
        @await Component.InvokeAsync("_MessageCategoryListSideBarComponentsPartial")
       
        <hr>
        <div class="inbox-status">
            <ul class="inbox-st-nav inbox-nav-mg">
                <li><a href="#"><i class="notika-icon notika-success"></i> Forum</a></li>
                <li><a href="#"><i class="notika-icon notika-chat"></i> Chat</a></li>
                <li><a href="#"><i class="notika-icon notika-star"></i> Is Akisi</a></li>
                <li><a href="#"><i class="notika-icon notika-settings"></i> Ayarlar</a></li>
                <li><a href="#"><i class="notika-icon notika-support"></i> Destek</a></li>
            </ul>
        </div>
    </div>
</div>