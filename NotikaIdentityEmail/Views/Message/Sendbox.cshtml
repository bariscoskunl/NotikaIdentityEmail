@model List<MessageWithRecieverInfoViewModel>
@{
    ViewData["Title"] = "Inbox";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="inbox-area">
    <div class="container">
        <div class="row">

            @await Component.InvokeAsync("_MessageSidebarComponentPartial")

            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                <div class="inbox-text-list sm-res-mg-t-30">
                    <div class="form-group">
                        <div class="nk-int-st search-input search-overt">
                            <p>@ViewBag.SenderEmail</p>
                            <input type="text" class="form-control" placeholder="Aranacak kelimeleri giriniz..." />
                            <button class="btn search-ib">Ara</button>
                        </div>
                    </div>
                    <div class="inbox-btn-st-ls btn-toolbar">
                        <div class="btn-group ib-btn-gp active-hook nk-email-inbox">
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-refresh"></i> Yenile</button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-next"></i></button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-down-arrow"></i></button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-trash"></i></button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-checked"></i></button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-promos"></i></button>
                        </div>
                        <div class="btn-group ib-btn-gp active-hook nk-act nk-email-inbox">
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-left-arrow"></i></button>
                            <button class="btn btn-default btn-sm"><i class="notika-icon notika-right-arrow"></i></button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-inbox" style="table-layout: fixed; width: 100%;">
                            <colgroup>
                                <col style="width: 40px;" />
                                <col style="width: 22%;" />
                                <col style="width: 28%;" />
                                <col style="width: 14%;" />
                                <col style="width: 15%;" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Alıcı</th>
                                    <th>Konu</th>
                                    <th>Kategori</th>
                                    <th style="white-space: nowrap;">Gönderim Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="text-align:center;"><label><input type="checkbox" class="i-checks"></label></td>
                                        <td style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            <a href="#">
                                            @if (item.RecieverName == "Bilinmeyen")
                                            {
                                                @item.RecieverEmail
                                            }
                                            else
                                            {
                                                @(item.RecieverName + " " + item.RecieverSurname)
                                            }
                                            </a>
                                        </td>
                                        <td style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                            <a href="#" title="@item.Subject">@item.Subject</a>
                                        </td>
                                        @switch (item.CategoryName)
                                        {
                                            case "Egitim":
                                                <td><span class="label label-warning">@item.CategoryName</span></td>
                                                break;
                                            case "Kampanyalar":
                                                <td><span class="label label-info">@item.CategoryName</span></td>
                                                break;
                                            case "Sosyal":
                                                <td><span class="label label-success">@item.CategoryName</span></td>
                                                break;
                                            case "Finans":
                                                <td><span class="label label-primary">@item.CategoryName</span></td>
                                                break;
                                            case "Seyahat":
                                                <td><span class="label label-default">@item.CategoryName</span></td>
                                                break;
                                            default:
                                                <td><span class="label label-default">@item.CategoryName</span></td>
                                                break;
                                        }
                                        <td class="mail-date" style="white-space: nowrap; text-align: right;">@item.SendDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

