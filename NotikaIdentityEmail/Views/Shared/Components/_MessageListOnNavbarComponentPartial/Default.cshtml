@model List<MessageListWithUserInfoViewModel>

<li class="nav-item dropdown">
    <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle"><span><i class="notika-icon notika-mail"></i></span><div class="spinner4 spinner-4" style="left: 20px;"></div><div class="ntd-ctn" style="left: 25px;"><span>@ViewBag.userEmailCount</span></div></a>
    <div role="menu" class="dropdown-menu message-dd animated zoomIn">
        <div class="hd-mg-tt">
            <h2>Messages</h2>
        </div>
        <div class="hd-message-info">
            @foreach (var item in Model)
            {
                <a href="#">
                    <div class="hd-message-sn">
                        <div class="hd-message-img">
                            @if (!string.IsNullOrEmpty(item.FullProfileImageUrl))
                            {
                                <img src="@Url.Content("~" + item.FullProfileImageUrl)" alt="@item.FullName" class="img-circle" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/userimages/default.jpg")" alt="@item.FullName" class="img-circle" />
                            }
                        </div>
                        <div class="hd-mg-ctn">
                            <h3>@item.FullName</h3>
                            <p>@item.MessageDetail</p>
                        </div>
                    </div>
                </a>
            }
        </div>
        <div class="hd-mg-va">
            <a href="#">Hepsini Gor</a>
        </div>
    </div>
</li>
