@model UpdateRoleViewModel
@{
    TempData["Title"] = "UpdateRole";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Role Güncelleme Sayfası</h2>                        
                    </div>
                    <form method="post">
                        <div class="row">
                            <input type="hidden" asp-for="RoleId"/>
                            @* Ad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="RoleName" class="form-control" placeholder="Role Adı">
                                    </div>
                                </div>
                            </div>

                            @* Soyad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <button type="submit" class="btn btn-primary">Güncelle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>