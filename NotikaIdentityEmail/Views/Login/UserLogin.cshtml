@model UserLoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Giriş Yap";
}

<!-- Login -->
<div class="nk-block toggled" id="l-login">
    <div class="nk-form">
        <h3 style="margin-bottom: 25px; color: #333;">Notika Yönetim Paneli</h3>
        
        <form asp-action="UserLogin" asp-controller="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            
            <div class="input-group">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-support"></i></span>
                <div class="nk-int-st">
                    <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adı veya E-posta">
                </div>
            </div>
            <span asp-validation-for="UserName" class="field-validation-error"></span>

            <div class="input-group mg-t-15">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-edit"></i></span>
                <div class="nk-int-st">
                    <input type="password" asp-for="Password" class="form-control" placeholder="Şifre">
                </div>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>

            <button type="submit" class="btn btn-login btn-success btn-float"><i class="notika-icon notika-right-arrow right-arrow-ant"></i></button>
            
            <button type="submit" formnovalidate asp-action="ExternalLogin" asp-controller="Login" name="provider" value="Google" class="google-btn">
                <i class="fa fa-google"></i> Google ile Giriş Yap
            </button>
        </form>
    </div>

    <div class="nk-navigation nk-lg-ic">
        <a asp-controller="Register" asp-action="CreateUser"><i class="notika-icon notika-plus-symbol"></i> <span>Kayıt Ol</span></a>
        <a asp-controller="PasswordChange" asp-action="ForgetPassword"><i>?</i> <span>Şifremi Unuttum</span></a>
        <a asp-controller="Home" asp-action="Index"><i class="notika-icon notika-house"></i> <span>Ana Sayfa</span></a>
    </div>
</div>
