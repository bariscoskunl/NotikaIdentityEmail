@model ForgetPasswordViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Şifremi Unuttum";
}

<!-- Forgot Password -->
<div class="nk-block toggled" id="l-forget-password">
    <div class="nk-form">
        <h3 style="margin-bottom: 25px; color: #333;">Şifre Sıfırlama</h3>
        <p class="text-left" style="margin-bottom: 20px;">Lütfen sisteme kayıtlı olan e-posta adresinizi giriniz. Şifre sıfırlama bağlantısı e-posta adresinize gönderilecektir.</p>

        <form method="post" asp-action="ForgetPassword" asp-controller="PasswordChange">
            <div class="input-group">
                <span class="input-group-addon nk-ic-st-pro"><i class="notika-icon notika-mail"></i></span>
                <div class="nk-int-st">
                    <input type="email" asp-for="Email" class="form-control" placeholder="E-posta Adresi" required>
                </div>
            </div>

            <button type="submit" class="btn btn-login btn-success btn-float"><i class="notika-icon notika-right-arrow"></i></button>
        </form>
    </div>

    <div class="nk-navigation nk-lg-ic rg-ic-stl">
        <a asp-controller="Login" asp-action="UserLogin"><i class="notika-icon notika-right-arrow"></i> <span>Giriş Yap</span></a>
        <a asp-controller="Register" asp-action="CreateUser"><i class="notika-icon notika-plus-symbol"></i> <span>Kayıt Ol</span></a>
        <a asp-controller="Home" asp-action="Index"><i class="notika-icon notika-house"></i> <span>Ana Sayfa</span></a>
    </div>
</div>
