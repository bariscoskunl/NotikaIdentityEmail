@model UserEditViewModel
@{
    ViewData["Title"] = "EditProfile";
    Layout = "~/Views/UserLayout/Index.cshtml";
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Profilimi Düzenle</h2>
                        <p>bilgileri eksiksiz olarak doldurup güncelleme işlemini yapınız.</p>
                    </div>
                    <form method="post">
                        <div class="row">
                            @* Ad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Name" class="form-control" placeholder="Adınız">
                                    </div>
                                </div>
                            </div>

                            @* Soyad *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-support"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız">
                                    </div>
                                </div>
                            </div>

                            @* Şehir *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-map"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="City" class="form-control" placeholder="Şehriniz">
                                    </div>
                                </div>
                            </div>

                            @* ImageUrl *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-picture"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf URL Bilgisi">
                                    </div>
                                </div>
                            </div>

                            @* UserName *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-user"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adınız">
                                    </div>
                                </div>
                            </div>

                            @* Email *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-mail"></i></div>
                                    <div class="nk-int-st">
                                        <input type="email" asp-for="Email" class="form-control" placeholder="Email Adresi">
                                    </div>
                                </div>
                            </div>

                            @* PhoneNumber *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-phone"></i></div>
                                    <div class="nk-int-st">
                                        <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numarası">
                                    </div>
                                </div>
                            </div>

                            @* Password (Manual handling recommended) *@
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-edit"></i></div>
                                    <div class="nk-int-st">
                                        <input type="password" asp-for="Password" class="form-control" placeholder="Yeni Şifre (Değiştirmeyecekseniz boş bırakın)">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group ic-cmp-int">
                                    <div class="form-ic-cmp"><i class="notika-icon notika-edit"></i></div>
                                    <div class="nk-int-st">
                                        <input type="password" asp-for="PasswordConfirm" class="form-control" placeholder="Şifre Tekrar">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div style="margin-top: 20px;">
                                    <button type="submit" class="btn btn-success success-icon-notika">
                                        <i class="notika-icon notika-checked"></i> Bilgileri Güncelle
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>