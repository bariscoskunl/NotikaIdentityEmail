@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>
@{
    TempData["Title"] = "RoleList";
    Layout = "~/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<div class="form-element-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-element-list">
                    <div class="basic-tb-hd">
                        <h2>Role Olusturma Sayfgasi</h2>
                    </div>
                     <div class="row">
                        <table class="table table-bordered ">
                            <tr>
                                <th>#</th>
                                <th>Rol Adı</th>
                                <th>Rol Sil</th>
                                <th>Rol Guncelle</th>
                            </tr>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                        <td><a asp-action="DeleteRole" asp-route-id ="@item.Id" class="btn btn-danger">Sil</a></td>
                                        <td><a asp-action="UpdateRole" asp-route-id ="@item.Id" class="btn btn-primary">Guncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>   
                        <a asp-action="CreateRole" class="btn btn-success">Yeni Role Ekle</a>
                     </div>
                </div>
            </div>
        </div>
    </div>
</div>