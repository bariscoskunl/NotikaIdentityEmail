<div class="breadcomb-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="breadcomb-list">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                            <div class="breadcomb-wp">
                                <div class="breadcomb-icon">
                                    <i class="notika-icon notika-mail"></i>
                                </div>
                                <div class="breadcomb-ctn">
                                    <h2>@(ViewData["Title"] ?? "Notika Panel")</h2>
                                    <p>@(ViewData["Description"] ?? "Notika Yönetim Paneline Hoşgeldiniz")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-3">
                            <div class="breadcomb-report">
                                <a asp-controller="Message" asp-action="ComposeMessage" data-toggle="tooltip" data-placement="left" title="Yeni Mesaj Oluştur" class="btn"><i class="notika-icon notika-edit"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
